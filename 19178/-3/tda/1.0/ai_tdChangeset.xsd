  <xs:include schemaLocation="./ai_trainingData.xsd" />
  <xs:element name="AI_TDChangeset" type="tda:AI_TDChangeset" />
  <xs:complexType name="AI_TDChangeset">
    <xs:sequence>
      <xs:element name="id" type="xs:string" />
      <xs:element name="datasetId" type="xs:string" minOccurs="0" />
      <xs:element name="version" type="xs:string" minOccurs="0" />
      <xs:element name="changeCount" type="xs:int" />
      <xs:element name="createdTime" type="xs:dateTime" minOccurs="0" />
      <xs:element name="add" type="tda:AI_AbstractTrainingData" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="modify" type="tda:AI_AbstractTrainingData" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="delete" type="tda:AI_AbstractTrainingData" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>