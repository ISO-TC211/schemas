      additional rights of use, visit https://www.ogc.org/legal/ .
    </xs:documentation>
  </xs:annotation>
  

  <xs:import namespace="https://schemas.isotc211.org/19115/-1/mrc/1.3"
    schemaLocation="https://schemas.isotc211.org/19115/-1/mrc/1.3.0/content.xsd" />


  <xs:include schemaLocation="./ai_trainingDataset.xsd" />
  <xs:element name="AI_EOTrainingDataset" type="AI_EOTrainingDataset" />
  <xs:complexType name="AI_EOTrainingDataset">
    <xs:complexContent>
      <xs:extension base="AI_AbstractTrainingDataset">
        <xs:sequence>
          <xs:element name="bands" type="mrc:MD_Band_Type" minOccurs="0" maxOccurs="unbounded" />
          <xs:element name="imageSize" type="xs:string" minOccurs="0" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>