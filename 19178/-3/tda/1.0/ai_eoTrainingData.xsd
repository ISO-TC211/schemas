<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.opengis.net/trainingdml-ai/part3/1.0"
  targetNamespace="http://www.opengis.net/trainingdml-ai/part3/1.0"
  xmlns:mri="https://schemas.isotc211.org/19115/-1/mri/1.3"
  elementFormDefault="qualified" version="1.0.1">
  <xs:annotation>
    <xs:documentation xml:lang="en">
      This is a draft XML Schema for ISO 19178-3,
      Training data markup language for artificial intelligence - Part 3: XML encoding.
      This draft is provided for expert review.
      This XML Schema Document includes Earth observation training data definitions.
