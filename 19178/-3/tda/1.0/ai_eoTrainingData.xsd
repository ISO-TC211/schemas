      OGC Training Data Markup Language for Artificial Intelligence
      (TrainingDML-AI) is an OGC Standard. Copyright (c) 2025 Open Geospatial Consortium. To obtain
      additional rights of use, visit https://www.ogc.org/legal/ .
    </xs:documentation>
  </xs:annotation>
  
  <xs:import namespace="https://schemas.isotc211.org/19115/-1/mri/1.3"
    schemaLocation="https://schemas.isotc211.org/19115/-1/mri/1.3.0/identification.xsd" />
  <xs:include schemaLocation="./ai_trainingData.xsd" />
  <xs:element name="AI_EOTrainingData" type="AI_EOTrainingData" />
  <xs:complexType name="AI_EOTrainingData">
    <xs:complexContent>
      <xs:extension base="AI_AbstractTrainingData">
        <xs:sequence>
          <xs:element name="spatialResolution" type="mri:MD_Resolution_Type" minOccurs="0" />
          <xs:element name="dataURL" type="xs:anyURI" maxOccurs="unbounded" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>