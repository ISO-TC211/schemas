<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="https://schemas.isotc211.org/schemas/19178/-3/tda/1.0"
  xmlns:tda="https://schemas.isotc211.org/schemas/19178/-3/tda/1.0"
    targetNamespace="https://schemas.isotc211.org/schemas/19178/-3/tda/1.0"
    xmlns:cit="https://schemas.isotc211.org/19115/-1/cit/1.3"
    xmlns:mcc="https://schemas.isotc211.org/19115/-1/mcc/1.3"
    xmlns:gex="https://schemas.isotc211.org/19115/-1/gex/1.3"
    xmlns:mrs="https://schemas.isotc211.org/19115/-1/mrs/1.3"
    xmlns:mrl="https://schemas.isotc211.org/19115/-1/mrl/1.3"
    elementFormDefault="qualified" version="1.0.1">
  <xs:annotation>
    <xs:documentation xml:lang="en">
      This is the XML Schema for ISO 19178-3:2026
      Training data markup language for artificial intelligence - Part 3: XML encoding.

      This XML Schema Document includes abstract training dataset definitions.

      Last updated: 2026-10-28

      Copyright (c) 2026 ISO. All rights reserved.

      This work is a derived work based on OGC Standard 24-007r1,
      OGC Training Data Markup Language for Artificial Intelligence
      (TrainingDML-AI) Part 3: XML Encoding Standard,
      copyright (c) 2025 Open Geospatial Consortium (OGC). Used with permission.

      To obtain additional rights of use from OGC, visit https://www.ogc.org/legal/
    </xs:documentation>
  </xs:annotation>
    
    <xs:import namespace="https://schemas.isotc211.org/19115/-1/cit/1.3"
        schemaLocation="https://schemas.isotc211.org/19115/-1/cit/1.3.0/citation.xsd" />
    <xs:import namespace="https://schemas.isotc211.org/19115/-1/mcc/1.3"
        schemaLocation="https://schemas.isotc211.org/19115/-1/mcc/1.3.0/commonClasses.xsd" />
    <xs:import namespace="https://schemas.isotc211.org/19115/-1/gex/1.3"
        schemaLocation="https://schemas.isotc211.org/19115/-1/gex/1.3.0/extent.xsd" />
    <xs:import namespace="https://schemas.isotc211.org/19115/-1/mrs/1.3"
        schemaLocation="https://schemas.isotc211.org/19115/-1/mrs/1.3.0/referenceSystem.xsd" />
    <xs:import namespace="https://schemas.isotc211.org/19115/-1/mrl/1.3"
        schemaLocation="https://schemas.isotc211.org/19115/-1/mrl/1.3.0/lineage.xsd" />
    <xs:include schemaLocation="./namedValue.xsd" />
    <xs:include schemaLocation="./ai_labeling.xsd" />
    <xs:include schemaLocation="./ai_metricsInLiterature.xsd" />
    <xs:include schemaLocation="./ai_task.xsd" />
    <xs:include schemaLocation="./dataQuality.xsd" />
    <xs:include schemaLocation="./ai_trainingData.xsd" />
    <xs:include schemaLocation="./ai_tdChangeset.xsd" />
    <xs:element name="AI_AbstractTrainingDataset" type="tda:AI_AbstractTrainingDataset" />
    <xs:complexType name="AI_AbstractTrainingDataset" abstract="true">
        <xs:sequence>
            <xs:element name="id" type="xs:string" />
            <xs:element name="doi" type="xs:string" minOccurs="0" />
            <xs:element name="scope" type="mcc:MD_Scope_Type" minOccurs="0" />
            <xs:element name="name" type="xs:string" />
            <xs:element name="description" type="xs:string" />
            <xs:element name="license" type="xs:string" />
            <xs:element name="version" type="xs:string" minOccurs="0" />
            <xs:element name="amountOfTrainingData" type="xs:int" minOccurs="0" />
            <xs:element name="createdTime" type="xs:dateTime" minOccurs="0" />
            <xs:element name="updatedTime" type="xs:dateTime" minOccurs="0" />
            <xs:element name="providers" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="keywords" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="metricsInLIT" type="tda:AI_MetricsInLiterature" minOccurs="0"
                maxOccurs="unbounded" />
            <xs:element name="statisticsInfo" type="tda:NamedValue" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="dataSources" type="cit:CI_Citation_Type" minOccurs="0"
                maxOccurs="unbounded" />
            <xs:element name="numberOfClasses" type="xs:int" minOccurs="0" />
            <xs:element name="classificationScheme" type="xs:string" minOccurs="0" />
            <xs:element name="classes" type="tda:NamedValue" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="extent" type="gex:EX_Extent_Type" minOccurs="0" />
            <xs:element name="referenceSystem" type="mrs:MD_ReferenceSystem_Type" minOccurs="0" />
            <xs:element name="lineage" type="mrl:LI_Lineage_Type" minOccurs="0"
                maxOccurs="unbounded" />

            <xs:element name="tasks" type="tda:AI_AbstractTask" maxOccurs="unbounded" />
            <xs:element name="labeling" type="tda:AI_Labeling" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="quality" type="tda:DataQuality" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="data" type="tda:AI_AbstractTrainingData" maxOccurs="unbounded" />
            <xs:element name="changesets" type="tda:AI_TDChangeset" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>