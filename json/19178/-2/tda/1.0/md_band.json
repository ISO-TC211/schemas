{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/md_band.json",
    "title": "ISO 19178-2 JSON Schema — MD_Band",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines the JSON representation of MD_Band. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "type": "object",
    "properties": {
        "sequenceIdentifier": {
            "$ref": "https://standards.iso.org/19178/2/1.0/memberName.json"
        },
        "description": {
            "type": "string"
        },
        "name": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#MD_Identifier"
            }
        },
        "maxValue": {
            "type": "number"
        },
        "minValue": {
            "type": "number"
        },
        "units": {
            "type": "string"
        },
        "scaleFactor": {
            "type": "number"
        },
        "offset": {
            "type": "number"
        },
        "meanValue": {
            "type": "number"
        },
        "numberOfValues": {
            "type": "integer"
        },
        "standardDeviation": {
            "type": "number"
        },
        "otherPropertyType": {
            "type": "string"
        },
        "otherProperty": {
            "type": "string"
        },
        "bitsPerValue": {
            "type": "integer"
        },
        "rangeElementDescription": {
            "type": "array",
            "items": {
                "$ref": "https://standards.iso.org/19178/2/1.0/mi_rangeElementDescription.json"
            }
        },
        "boundMax": {
            "type": "number"
        },
        "boundMin": {
            "type": "number"
        },
        "boundUnits": {
            "type": "string"
        },
        "peakResponse": {
            "type": "number"
        },
        "toneGradation": {
            "type": "integer"
        }
    },
    "dependentRequired": {
        "boundMax": [
            "boundUnits"
        ],
        "boundMin": [
            "boundUnits"
        ]
    }
}
