{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/ai_trainingData.json",
    "title": "ISO 19178-2 JSON Schema — AI_AbstractTrainingData",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines the common properties of a training sample. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "type": "object",
    "required": [
        "type",
        "id"
    ],
    "properties": {
        "type": {
            "type": "string"
        },
        "datasetId": {
            "type": "string"
        },
        "dataSources": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#CI_Citation"
            }
        },
        "id": {
            "type": "string"
        },
        "numberOfLabels": {
            "type": "integer"
        },
        "extent": {
            "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#EX_Extent"
        },
        "dataTime": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#DateOrDateTime"
            }
        },
        "lineage": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#LI_Lineage"
            }
        },
        "labels": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "allOf": [
                            {
                                "properties": {
                                    "type": {
                                        "const": "AI_AbstractLabel"
                                    }
                                },
                                "required": [
                                    "type"
                                ]
                            },
                            {
                                "$ref": "https://standards.iso.org/19178/2/1.0/ai_label.json"
                            }
                        ]
                    },
                    {
                        "$ref": "https://standards.iso.org/19178/2/1.0/ai_sceneLabel.json"
                    },
                    {
                        "$ref": "https://standards.iso.org/19178/2/1.0/ai_objectLabel.json"
                    },
                    {
                        "$ref": "https://standards.iso.org/19178/2/1.0/ai_pixelLabel.json"
                    }
                ]
            }
        },
        "labeling": {
            "type": "array",
            "items": {
                "$ref": "https://standards.iso.org/19178/2/1.0/ai_labeling.json"
            }
        },
        "trainingType": {
            "$ref": "https://standards.iso.org/19178/2/1.0/ai_trainingTypeCode.json"
        },
        "quality": {
            "type": "array",
            "items": {
                "$ref": "https://standards.iso.org/19178/2/1.0/dataQuality.json"
            }
        }
    }
}
