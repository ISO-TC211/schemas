            "type": "string"
        },
        "resultSpatialRepresentation": {
            "$ref": "https://standards.iso.org/19178/2/1.0/md_spatialRepresentation.json"
        },
        "resultContent": {
            "type": "array",
            "items": {
                "$ref": "https://standards.iso.org/19178/2/1.0/md_rangeDimension.json"
            }
        },
        "resultFormat": {
            "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#MD_Format"
        }
    }
}
