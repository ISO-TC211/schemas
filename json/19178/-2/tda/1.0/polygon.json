{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/polygon.json",
    "title": "ISO 19178-2 JSON Schema — Polygon",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines the JSON representation of Polygon. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "type": "object",
    "properties": {
        "description": {
            "type": "string"
        },
        "descriptionReference": {
            "type": "string"
        },
        "identifier": {
            "type": "string"
        },
        "name": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "exterior": {
            "type": "object",
            "required": [
                "LinearRing"
            ],
            "properties": {
                "LinearRing": {
                    "$ref": "https://standards.iso.org/19178/2/1.0/LinearRing.json"
                }
            }
        },
        "interior": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "LinearRing"
                ],
                "properties": {
                    "LinearRing": {
                        "$ref": "https://standards.iso.org/19178/2/1.0/LinearRing.json"
                    }
                }
            }
        }
    }
}
