{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/ai_pixelLabel.json",
    "title": "ISO 19178-2 JSON Schema — AI_PixelLabel",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines a pixel label with image references and image formats. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "allOf": [
        {
            "$ref": "https://standards.iso.org/19178/2/1.0/ai_label.json"
        },
        {
            "type": "object",
            "required": [
                "type",
                "imageURL",
                "imageFormat"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "AI_PixelLabel"
                    ]
                },
                "imageFormat": {
                    "type": "array",
                    "items": {
                        "$ref": "https://standards.iso.org/19178/2/1.0/ai_imageFormatCode.json"
                    },
                    "minItems": 1
                },
                "imageURL": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "minItems": 1
                }
            }
        }
    ]
}
