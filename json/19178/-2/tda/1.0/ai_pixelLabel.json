{
    "$schema": "https://json-schema.org",
    "$id": "https://standards.iso.org/19178/2/1.0/ai_pixelLabel.json",
    "title": "ISO 19178-2 JSON Schema",
    "description": "ISO 19178-2:2026 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines a pixel label with image references and image formats. Last updated: 2026-10-28. Copyright (c) 2026 ISO. All rights reserved. This work is a derived work based on OGC Standard 24-006r4, copyright (c) 2026 Open Geospatial Consortium (OGC). Used with permission. To obtain additional rights of use from OGC, visit http://www.opengeospatial.org/legal/",
    "allOf": [
        {
            "$ref": "https://standards.iso.org/19178/2/1.0/ai_label.json"
        },
        {
            "type": "object",
            "required": [
                "type",
                "imageURL",
                "imageFormat"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "AI_PixelLabel"
                    ]
                },
                "imageFormat": {
                    "type": "array",
                    "items": {
                        "$ref": "https://standards.iso.org/19178/2/1.0/ai_imageFormatCode.json"
                    },
                    "minItems": 1
                },
                "imageURL": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "minItems": 1
                }
            }
        }
    ]
}
