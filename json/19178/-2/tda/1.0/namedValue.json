{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/namedValue.json",
    "title": "ISO 19178-2 JSON Schema — NamedValue",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines the JSON representation of NamedValue. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "type": "object",
    "required": [
        "key",
        "value"
    ],
    "properties": {
        "key": {
            "type": "string"
        },
        "value": {
            "$comment": "The type of the value is 'any'.",
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "object"
                },
                {
                    "type": "number"
                },
                {
                    "type": "array"
                },
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ]
        }
    }
}
