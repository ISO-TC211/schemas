{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://standards.iso.org/19178/2/1.0/ai_eoTrainingData.json",
    "title": "ISO 19178-2 JSON Schema — AI_EOTrainingData",
    "description": "ISO 19178-2 Training data markup language for artificial intelligence — Part 2: JSON encoding. Defines an Earth observation training sample. Last updated: 2026-10-20. Copyright (c) ISO. All rights reserved.",
    "allOf": [
        {
            "$ref": "https://standards.iso.org/19178/2/1.0/ai_trainingData.json"
        },
        {
            "type": "object",
            "required": [
                "type",
                "dataURL"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "AI_EOTrainingData"
                    ]
                },
                "spatialResolution": {
                    "$ref": "https://standards.iso.org/19178/2/1.0/md_resolution.json"
                },
                "dataURL": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "minItems": 1
                }
            }
        }
    ]
}
